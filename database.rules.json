{
  "rules": {
    ".read": false,
    ".write": false,
    "kano": {
      "sessions": {
        "$code": {
          ".read": true,
          ".write": true,
          "proposals": { "$id": { "text": { ".validate": "newData.isString() && newData.val().length <= 90" } } }
        }
      }
    },
    "afinitate": {
      "sessions": {
        "$code": {
          ".read": true,
          ".write": true,
          "ideas": { "$id": { "text": { ".validate": "newData.isString() && newData.val().length <= 140" } } }
        }
      }
    }
  }
}
